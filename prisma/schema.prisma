generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Staging only: manual reconciliation, no live inventory or automated settlement.
model PaymentReceiver {
  id           String   @id @default(cuid())
  label        String
  method       String
  destination  String
  bank         String
  holder       String
  qrPath       String
  active       Boolean  @default(false)
  pendingLimit Int      @default(10)
  lastAssigned DateTime @default(now())
  orders       PaymentOrder[]
}

model PaymentOrder {
  id               String   @id @default(cuid())
  requestKey       String   @unique
  receiverId       String
  receiver         PaymentReceiver @relation(fields: [receiverId], references: [id])
  receiverSnapshot Json
  lines            Json
  usdCents         Int
  amountMinor      BigInt
  unitsPerUsd      BigInt
  method           String
  status           String   @default("PENDING")
  reference        String   @unique
  transactionKey   String?  @unique
  deliveryNote     String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  events           PaymentEvent[]
  @@index([receiverId, status])
}

model PaymentEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     PaymentOrder @relation(fields: [orderId], references: [id])
  actor     String
  action    String
  createdAt DateTime @default(now())
}

model Product {
  id           String               @id @default(cuid())
  slug         String               @unique
  category     String               @default("general")
  sortOrder    Int                  @default(0)
  imagePath    String               @default("")
  active       Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations ProductTranslation[]
  packages     Package[]
}

model ProductImage {
  id           String   @id @default(cuid())
  sha256       String   @unique
  mimeType     String
  originalName String
  sizeBytes    Int
  data         Bytes
  createdAt    DateTime @default(now())
}

model ProductTranslation {
  productId   String
  locale      String
  title       String
  description String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
}

model Package {
  id                    String             @id @default(cuid())
  productId             String
  sku                   String             @unique
  baseUsdCents          Int
  saleUsdCents          Int?
  stockOnHand           Int                @default(0)
  active                Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  product               Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations          PackageTranslation[]
  deliveryForms         DeliveryForm[]
  @@index([productId, active])
}

model PackageTranslation {
  packageId   String
  locale      String
  title       String
  description String
  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([packageId, locale])
}

model DeliveryForm {
  id        String   @id @default(cuid())
  packageId String
  version   Int
  fields    Json
  createdAt DateTime @default(now())
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, version])
}

// Phase 1: customer accounts, sign-in history and support chat (see docs/specs).
model Customer {
  id                 String            @id @default(cuid())
  email              String            @unique
  name               String
  passwordHash       String?
  googleSub          String?           @unique
  emailVerified      Boolean           @default(false)
  status             String            @default("active")
  lockedReason       String?
  mustChangePassword Boolean           @default(false)
  createdAt          DateTime          @default(now())
  lastLoginAt        DateTime?
  sessions           CustomerSession[]
  loginEvents        LoginEvent[]
  chatMessages       ChatMessage[]
  auditLogs          AuditLog[]

  @@index([createdAt])
  @@index([lastLoginAt])
}

model CustomerSession {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([customerId])
  @@index([expiresAt])
}

model LoginEvent {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email      String
  method     String
  outcome    String
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([customerId, createdAt])
}

model ChatMessage {
  id         String     @id @default(cuid())
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorRole String
  authorName String
  body       String
  imageId    String?    @unique
  image      ChatImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())

  @@index([customerId, createdAt])
}

model ChatImage {
  id        String       @id @default(cuid())
  mimeType  String
  name      String
  sizeBytes Int
  data      Bytes
  createdAt DateTime     @default(now())
  message   ChatMessage?

  @@index([createdAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorEmail String
  action     String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  summary    String
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([createdAt])
}
