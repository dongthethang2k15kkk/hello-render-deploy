DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game_shop?schema=public"
# Internal staging credentials: distinct random secrets, at least 32 characters.
# Keep empty to disable access. Never prefix these with NEXT_PUBLIC_.
# Admin staging key manages receivers, QR uploads and order processing.
PAYMENT_ADMIN_KEY=""
# Set a random AUTH_SECRET (at least 32 characters) before production.
AUTH_SECRET=""
# Reviewed manual quote rates; no default/automatic market rate.
PAYMENT_VND_PER_USD=""
PAYMENT_LITOSHI_PER_USD=""
PAYMENT_RATE_VALID_UNTIL=""
# Docker Compose local staging (random hexadecimal password).
POSTGRES_PASSWORD=""
APP_PORT=3000
