# PostgreSQL connection used by Prisma. On Render Free, use an external persistent
# provider such as Neon; include sslmode=require in its connection string.
# For the Docker Compose database, compose.db.yaml overrides this value for the app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game_shop?schema=public"
# Internal staging credentials: distinct random secrets, at least 32 characters.
# Keep empty to disable access. Never prefix these with NEXT_PUBLIC_.
# Admin staging key manages receivers, QR uploads and order processing.
PAYMENT_ADMIN_KEY=""
# Set a random AUTH_SECRET (at least 32 characters) before production.
AUTH_SECRET=""
# Reviewed manual quote rates; no default/automatic market rate.
PAYMENT_VND_PER_USD=""
PAYMENT_LITOSHI_PER_USD=""
PAYMENT_RATE_VALID_UNTIL=""
# Docker Compose local staging (random hexadecimal password).
POSTGRES_PASSWORD=""
APP_PORT=3000
# Admin sign-in is Google-only. Creating an OAuth client is free (no billing):
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Authorized redirect URIs: http://localhost:3000/api/auth/google/callback
#                           https://<render-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated Gmail addresses allowed to open Admin (checked on every request).
ADMIN_GOOGLE_EMAILS=""
# Public origin for the OAuth redirect URI, e.g. https://<render-domain>. Optional locally.
APP_URL=""
# Local/E2E only: 1 enables a Dev admin button. Ignored when NODE_ENV=production.
ALLOW_DEV_ADMIN_LOGIN=""
# Playwright only: a disposable PostgreSQL database that tests may write to. Never the production
# DATABASE_URL (global setup refuses the same host). Locally: a Neon schema-only branch; CI: a service container.
E2E_DATABASE_URL=""
